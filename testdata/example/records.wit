package example:records;

interface a {
	type value = string;

	record request {
		name: value,
		value: u32,
		attributes: list<u32>,
	}

	record response {
		value: value,
		rating: u32,
		attributes: list<u32>,
	}

	handle: func(r: request) -> response;

	record single { value: u32 }

	handle-single: func(e: single) -> single;
}

world imports {
	import a;
	export a;
}
