{
  "$schema": "https://beepboop.kjanat.dev/schema/v1.json",
  "streams": {
    "main": {
      "packages": ["pkg:golang/github.com/kjanat/go-modules"],
      "versionScope": "one-for-stream",
      "mustPublish": ["pkg:golang/github.com/kjanat/go-modules"],
      "versionSource": {
        "kind": "tags",
        "prefix": "v"
      },
      "workflows": {
        "release": {
          "file": "release.yaml",
          "mode": "observe",
          "ref": "refs/tags/v*",
          "publications": [
            "pkg:golang/github.com/kjanat/go-modules",
            "pkg:github/kjanat/go-modules"
          ]
        }
      },
      "packageTags": ["pkg:golang/github.com/kjanat/go-modules"],
      "promote": {
        "publishWhen": "version-pr-merged",
        "workflow": {
          "setup": {
            "job": "publish",
            "existingTriggers": "replace-with-dispatch",
            "commands": "beepboop publish",
            "binaries": {
              "builds": [
                {
                  "toolchain": "go",
                  "name": "wit-bindgen-go",
                  "module": ".",
                  "package": "./cmd/wit-bindgen-go",
                  "asset": "{name}-{go.os}-{go.arch}{ext}"
                }
              ],
              "targets": [
                "linux-amd64",
                "linux-arm64",
                "darwin-amd64",
                "darwin-arm64",
                "windows-amd64",
                "windows-arm64",
                "freebsd-amd64",
                "freebsd-386",
                "freebsd-arm64"
              ]
            }
          },
          "file": "publish.yaml",
          "ref": "master",
          "publications": ["github-release:kjanat/go-modules"],
          "refs": {
            "phase": "version",
            "prefix": "v"
          }
        }
      },
      "startFrom": [
        {
          "via": "action",
          "workflow": "start-release.yml"
        }
      ]
    }
  },
  "managers": ["github-release", "go", "workflow"]
}
